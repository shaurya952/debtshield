<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Apple has required a privacy manifest since May 2024 for apps using
      "required reason" APIs. DebtShield uses UserDefaults, which is one of
      them, so this file is mandatory for App Store submission.

      Every entry was checked against the source. The app makes no network
      requests, contains no analytics or advertising SDK, and never accesses
      location, contacts, camera, photos, health, or the pasteboard.
    -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
      Nothing is collected under Apple's definition. The person's name, email,
      money numbers, chosen home county, and month history are stored only on
      the device (UserDefaults) and are never transmitted off it, so they are
      not "collected" data.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!--
              UserDefaults, used only for this app's own on-device settings:
              the person's money plan, name and email, chosen home county,
              month history, and whether onboarding has been seen. CA92.1 is
              the reason code for accessing UserDefaults solely for the
              containing app.
            -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
