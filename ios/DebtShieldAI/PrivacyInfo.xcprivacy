<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Apple has required a privacy manifest since May 2024 for apps using
      "required reason" APIs. DebtShield AI uses UserDefaults, which is one of
      them, so this file is mandatory for App Store submission.

      Every entry was checked against the source. The app makes no network
      requests, contains no analytics or advertising SDK, and never accesses
      location, contacts, camera, photos, health, or the pasteboard.
    -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
      Nothing is collected. Saved and recently viewed counties are FIPS codes
      held on device only and never transmitted, so under Apple's definition
      they are not "collected" data.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!--
              UserDefaults, used only for this app's own settings: saved
              counties, recently viewed counties, the recommendations audience
              preference, and whether onboarding has been seen. CA92.1 is the
              reason code for accessing UserDefaults solely for the containing
              app.
            -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
